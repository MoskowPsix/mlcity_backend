APP_NAME=VOKRUG.CITY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8001
APP_URL=http://localhost:8001
FRONT_APP_URL=http://localhost:8101

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Внутренний postgres compose (vokrug_database). Не путать с БД кабинета на проде.
DB_HOST=db
DB_PORT=5432
DB_PUBLISH_PORT=5435
DB_DATABASE=vokrug_test
DB_USERNAME=vokrug
DB_PASSWORD=vokrug

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8100,localhost:8101,127.0.0.1,127.0.0.1:8100,127.0.0.1:8101
SESSION_LIFETIME=120

REDIS_HOST=cache
REDIS_PASSWORD=
REDIS_PORT=6379

ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_ENABLED=false

KIBANA_PORT=5602

MOTOTRACK_INTEGRATION_API_KEY=
MOTOTRACK_INTEGRATION_USER_ID=1

# Источник RFID-событий (Hron / mototrack-device-service).
# На проде: https://api.hron.vokrug.city
# Sync — отдельный контейнер moto_rfid_sync (php artisan mototrack:rfid-sync --sleep=5), не schedule.
MOTOTRACK_DEVICE_SERVICE_URL=http://host.docker.internal:8080
MOTOTRACK_DEVICE_SERVICE_TOKEN=
MOTOTRACK_DEVICE_SERVICE_TIMEOUT=5
MOTOTRACK_DEVICE_SERVICE_POLL_LIMIT=100
MOTOTRACK_RFID_MIN_RUN_DURATION_MS=5000

# БД, куда moto_rfid_sync пишет круги. Должна совпадать с API/MoonShine кабинета.
# На проде НЕ оставляй внутренний db — кабинет смотрит в 192.168.220.251 / vokrug.
# Локально: RFID_SYNC_DB_HOST=db и RFID_SYNC_DB_DATABASE=vokrug_test
RFID_SYNC_DB_HOST=192.168.220.251
RFID_SYNC_DB_PORT=5432
RFID_SYNC_DB_DATABASE=vokrug

CARTING_INTEGRATION_API_KEY=
CARTING_INTEGRATION_USER_ID=1
